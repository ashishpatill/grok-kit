<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>ai.botmemory.daemon.wake</string>
  <!-- Self-wake every 15 min: POST /wake to the local daemon (Mac host) -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/path/to/grok-kit/memory/daemon/launchd/wake.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>ENV_FILE</key><string>/path/to/grok-kit/memory/.env.local</string>
  </dict>
  <key>StartInterval</key><integer>900</integer>
  <key>StandardOutPath</key><string>/path/to/grok-kit/memory/ops/backups/wake.log</string>
  <key>StandardErrorPath</key><string>/path/to/grok-kit/memory/ops/backups/wake.err</string>
</dict>
</plist>
